fn loops.count(%0: i64) -> i64 {
b0:
    %1 = copy i64 0
    jump b1
b1:
    %2 = add i64 %1, 1
    %1 = copy i64 %2
    %3 = eq i8 %1, 5
    branch %3, b4, b5
b2:
    %5 = slt i8 %1, %0
    branch %5, b1, b3
b3:
    ret i64 %1
b4:
    jump b2
b5:
    %4 = sgt i8 %1, 8
    branch %4, b6, b7
b6:
    jump b3
b7:
    jump b2
}
