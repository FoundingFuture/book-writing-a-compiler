type forward.Point = struct { x: i64, y: i64 }
fn forward.twice(%0: ptr) -> i64 {
b0:
    %1 = ptradd %0, offset_of forward.Point.y
    %2 = load i64 %1
    %3 = ptradd %0, offset_of forward.Point.y
    %4 = load i64 %3
    %5 = add i64 %2, %4
    ret i64 %5
}
fn forward.round_trip(%0: ptr, %1: i64) -> i64 {
b0:
    store i64 %1, %0
    %2 = load i64 %0
    %3 = load i64 %0
    %4 = add i64 %2, %3
    ret i64 %4
}
