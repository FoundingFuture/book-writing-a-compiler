extern fn abs(x: i32) -> i32;

struct Op
{
	apply: fn(i32) -> i32,
}

fn twice(x: i32) -> i32
{
	return x * 2;
}

fn run(op: *Op, x: i32) -> i32
{
	return op.apply(x);
}

fn main() -> int
{
	let ops = [Op { apply: twice }, Op { apply: abs }];
	return run(&ops[0], 5) as int + run(&ops[1], -3) as int;
}
