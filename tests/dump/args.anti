extern fn printf(format: *byte, ...) -> i32;

fn eight(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int) -> int
{
	return a + h;
}

fn main() -> int
{
	let format = alloc(byte, 4);
	format[0] = 37;
	format[1] = 100;
	format[2] = 10;
	format[3] = 0;
	printf(format, eight(1, 2, 3, 4, 5, 6, 7, 8));
	return 0;
}
