type []byte = struct { ptr: ptr, len: i64 }
type str = struct { ptr: ptr, len: i64 }
extern fn puts(ptr) -> i32
global strings.0 size 6 align 1 bytes 68 65 6c 6c 6f 00
global strings.1 size 3 align 1 bytes 68 69 00
fn strings.tail(%0: agg str, %1: i64) -> agg []byte {
b0:
    %2 = slot []byte
    %3 = load ptr %0
    %4 = ptradd %0, offset_of str.len
    %5 = load i64 %4
    %6 = mul i64 %1, size_of i8
    %7 = ptradd %3, %6
    store ptr %7, %2
    %8 = sub i64 %5, %1
    %9 = ptradd %2, offset_of []byte.len
    store i64 %8, %9
    ret ptr %2
}
fn strings.main() -> i64 {
b0:
    %0 = slot []byte
    %1 = slot str
    %2 = addr @strings.0
    store ptr %2, %1
    %3 = ptradd %1, offset_of str.len
    store i64 5, %3
    %4 = call agg @strings.tail(%1, 1)
    memcopy %0, %4, []byte
    %5 = addr @strings.1
    %6 = call i32 @puts(%5)
    %7 = load ptr %0
    %8 = ptradd %7, 0
    %9 = load i8 %8
    %10 = zext i64 %9
    ret i64 %10
}
