//! An atomic field is read and written by calls alone, so every access is
//! one sequentially consistent operation. `static atomic` declares a
//! field of the class, which is a global with the class's symbol.

extern fn printf(format: *byte, ...) -> c_int;

class Counter
{
	pub atomic n: int,

	static atomic total: int = 0;

	pub fn bump(self) -> int
	{
		Counter.total.add(1);
		return self.n.add(1);
	}
}

fn main() -> int
{
	let c = Counter { n: 0 };

	c.n.store(5);
	printf("%d\n".ptr, c.bump() as c_int);
	printf("%d %d\n".ptr, c.n.load() as c_int, Counter.total.load() as c_int);
	printf("%d\n".ptr, Counter.total.compare_swap(1, 9) as c_int);
	printf("%d\n".ptr, Counter.total.compare_swap(1, 4) as c_int);
	printf("%d %d\n".ptr, Counter.total.swap(3) as c_int,
		Counter.total.load() as c_int);
	printf("%d %d\n".ptr, c.n.sub(2) as c_int, c.n.load() as c_int);
	printf("%d %d\n".ptr, c.n.or(1) as c_int, c.n.and(6) as c_int);
	return 0;
}
