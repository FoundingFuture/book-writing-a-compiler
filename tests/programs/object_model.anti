//! The parts of the object model that reach a running program: an enum
//! with an underlying type, field defaults, a constant of a body, a
//! static function, the method sugar, a private function, promotion
//! through `use`, and a pointer that converts to its base.

extern fn printf(format: *byte, ...) -> c_int;

enum Kind: u8 { Circle, Square }

struct Counter
{
	n: int = 0,

	const STEP: int = 2;

	pub fn make(start: int) -> Counter
	{
		return Counter { n: start };
	}

	fn twice(self) -> int
	{
		return self.n * 2;
	}

	pub fn bump(self)
	{
		self.n = self.n + Counter.STEP;
	}

	pub fn doubled(self) -> int
	{
		return self.twice();
	}
}

struct Box
{
	w: int = 1,
	h: int = 1,

	pub fn area(self) -> int
	{
		return self.w * self.h;
	}
}

struct Sprite
{
	use hitbox: Box,
	texture: int,
}

struct Shape
{
	kind: Kind,
}

struct Circle
{
	inherits shape: Shape,
	r: int,
}

fn kind_of(s: *Shape) -> int
{
	return s.kind as int;
}

fn main() -> int
{
	let c = Counter.make(5);
	c.bump();
	printf("counter %d %d\n".ptr, c.n as c_int, c.doubled() as c_int);

	let s = Sprite { hitbox: Box { w: 3, h: 4 }, texture: 9 };
	printf("sprite %d %d %d\n".ptr, s.area() as c_int, s.w as c_int,
		s.texture as c_int);

	let circle = Circle { shape: Shape { kind: Kind.Square }, r: 2 };
	printf("circle %d %d\n".ptr, kind_of(&circle), circle.r as c_int);
	return 0;
}
