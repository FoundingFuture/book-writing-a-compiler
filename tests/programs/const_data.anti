//! An aggregate constant, which is read-only data of the module. The
//! `str` field holds the address of the literal, so the data carries a
//! relocation and the emitter writes it in the section for data the
//! loader fills in.

extern fn printf(format: *byte, ...) -> c_int;

struct Release
{
	name: str,
	major: u8,
	minor: i32,
}

const CURRENT: Release = Release { name: "anti", major: 0, minor: 1 };

const LIMITS: [4]i32 = [7, 8, 9, 10];

fn main() -> int
{
	let r = CURRENT;
	printf("%.*s %d.%d\n".ptr, r.name.len as c_int, r.name.ptr,
		r.major as c_int, r.minor as c_int);
	let total = 0;
	let i = 0;
	while i < LIMITS.len do {
		total += LIMITS[i] as int;
		i += 1;
	}
	printf("total %d\n".ptr, total as c_int);
	return 0;
}
