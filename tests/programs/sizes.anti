extern fn printf(format: *byte, ...) -> i32;

struct Header
{
	tag: u8,
	count: i32,
	next: *Header,
}

const HEADER: int = size_of(Header);

struct Buffer
{
	head: Header,
	pad: [HEADER - 12]byte,
}

fn main() -> int
{
	let b: [HEADER]byte = [1; HEADER];
	let total = 0;
	let i = 0;
	while i < b.len do {
		total = total + b[i] as int;
		i = i + 1;
	}
	printf("%lld %lld %lld\n".ptr, HEADER, total, size_of(Buffer));
	return b.len - 16;
}
