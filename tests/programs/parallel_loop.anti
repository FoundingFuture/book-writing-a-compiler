/* A thousand dispatches, each freeing its results. The heap must not
   grow, which a sanitizer build of the runtime checks. */

worker fn total(chunk: []int) -> int
{
	let sum = 0;
	let i = 0;
	while i < chunk.len do {
		sum = sum + chunk[i];
		i = i + 1;
	}
	return sum;
}

fn main() -> int
{
	let numbers = [1, 2, 3, 4, 5, 6, 7, 8];
	let all = numbers[0..8];
	let rounds = 0;
	let last = 0;

	while rounds < 1000 do {
		let parts = parallel all by 4 -> total;
		let sum = 0;
		let i = 0;
		while i < parts.len do {
			sum = sum + parts[i];
			i = i + 1;
		}
		free(parts.ptr);
		last = sum;
		rounds = rounds + 1;
	}
	return last;
}
